# Copy to .env and adjust. Never commit the real .env file.

NODE_ENV=development
PORT=3000

# Required in production. Use a long random string, e.g. `openssl rand -hex 32`.
JWT_SECRET=
JWT_TTL=8h

# PIN given to every locality admin the first time the database is created.
# Required in production; defaults to 1234 in development only.
# Change individual PINs later with: npm run set-pin -- "Downtown" 5678
ADMIN_DEFAULT_PIN=

# Comma-separated list of browser origins allowed to call the API from another site.
# Leave empty when the backend serves the frontend itself (same origin).
CORS_ORIGIN=

# Path to the folder holding index.html, styles.css and app.js (served as static files).
FRONTEND_DIR=../frontend

# Where the JSON database is stored.
DATA_FILE=./data/db.json

# true/false. Defaults to true in development and false in production.
SEED_DEMO_DATA=

# Set when running behind a reverse proxy so rate limits see the real client IP (e.g. 1).
TRUST_PROXY=
